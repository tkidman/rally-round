<div class="container home">
  {{#if hero}}
  <section class="home-hero home-hero--{{hero.state}}">
    <div class="home-hero__body">
      <div class="home-hero__eyebrow">
        {{#if hero.live}}<span class="home-hero__dot" aria-hidden="true"></span>{{/if}}
        <span>{{hero.statusLabel}} · {{localization.round}} {{hero.roundNumber}} {{localization.of}} {{hero.totalRounds}}</span>
      </div>
      <h1 class="home-hero__title">
        <span class="home-hero__title-line">{{hero.title}}</span>
        {{#if hero.subtitle}}
        <span class="home-hero__title-line home-hero__title-line--muted">{{hero.subtitle}}</span>
        {{/if}}
      </h1>
      <div class="home-hero__meta">
        {{#if hero.locationCode}}
        <img class="home-hero__flag" src="./assets/country-flags/{{hero.locationCode}}.png" alt="{{hero.locationCode}}" />
        {{/if}}
        <span>{{hero.divisionName}}</span>
        {{#if hero.startDate}}
        <span class="home-hero__meta-sep" aria-hidden="true">·</span>
        <span>{{localization.starts}} {{hero.startDate}}</span>
        {{/if}}
      </div>
      <div class="home-hero__actions">
        {{#if hero.resultsHref}}
        <a class="home-btn home-btn--primary" href="{{hero.resultsHref}}">{{localization.view_results}}</a>
        {{/if}}
        <a class="home-btn" href="{{hero.standingsHref}}">{{localization.view_standings}}</a>
      </div>
      {{#if otherActiveEvents.length}}
      <div class="home-hero__also">
        <span class="home-hero__also-label">{{localization.also_running}}</span>
        {{#each otherActiveEvents}}
        <a class="home-hero__also-item" href="./{{this.divisionId}}-{{this.eventIndex}}-driver-results.html">
          {{this.division}} · {{this.name}}
        </a>
        {{/each}}
      </div>
      {{/if}}
    </div>
    {{#if endTime}}
    <div class="home-clock">
      <div class="home-clock__label" id="homeClockLabel">{{localization.closes_in}}</div>
      <div class="home-clock__units">
        <div class="home-clock__unit">
          <span class="home-clock__value" id="homeClockDays">–</span>
          <span class="home-clock__unit-label">{{localization.days}}</span>
        </div>
        <div class="home-clock__unit">
          <span class="home-clock__value" id="homeClockHours">–</span>
          <span class="home-clock__unit-label">{{localization.hours}}</span>
        </div>
        <div class="home-clock__unit">
          <span class="home-clock__value" id="homeClockMinutes">–</span>
          <span class="home-clock__unit-label">{{localization.minutes}}</span>
        </div>
        <div class="home-clock__unit">
          <span class="home-clock__value" id="homeClockSeconds">–</span>
          <span class="home-clock__unit-label">{{localization.seconds}}</span>
        </div>
      </div>
    </div>
    {{/if}}
  </section>
  {{/if}}

  {{#if championshipBattles.length}}
  <div class="home-duo">
    {{#each divisionPanels}}
    {{#with this.battle}}
    <section class="home-card home-duo__battle battle{{#if this.tightBattle}} battle--tight{{/if}}">
      <header class="home-card__head">
        <h2 class="home-card__title">
          {{@root.localization.championship_battles}}
          {{#if @root.multipleDivisions}}<span class="home-card__title-note">{{this.divisionName}}</span>{{/if}}
        </h2>
        <span class="home-card__meta">
          {{this.eventsRemaining}} {{#if (eq this.eventsRemaining 1)}}{{@root.localization.event_remaining}}{{else}}{{@root.localization.events_remaining}}{{/if}} · {{this.maxPointsPerEvent}} {{@root.localization.pts}}{{#if this.maxPowerStagePoints}} + {{this.maxPowerStagePoints}} {{@root.localization.ps}}{{/if}} {{@root.localization.max_per_round}}
        </span>
      </header>
      <div class="battle__grid">
        <div class="battle__side">
          <div class="battle__driver">
            <img src="./assets/country-flags/{{this.leaderCountry}}.png" class="img-sm" alt="{{this.leaderCountry}}" />
            <span class="battle__name">{{this.leader}}</span>
          </div>
          <div class="battle__points">
            {{this.leaderPoints}}
            <span class="battle__points-unit">{{#if this.dropRoundPoints}}{{@root.localization.adr}}{{else}}{{@root.localization.pts}}{{/if}}</span>
          </div>
          <div class="battle__bar"><span class="battle__bar-fill" style="width: 100%"></span></div>
        </div>
        <div class="battle__gap">
          <div class="battle__gap-value">+{{this.gap}}</div>
          <div class="battle__gap-label">{{@root.localization.pt_gap}}</div>
          {{#if this.tightBattle}}
          <span class="battle__badge battle__badge--tight">{{@root.localization.tight}}</span>
          {{else if this.mathematicallyOpen}}
          <span class="battle__badge">{{@root.localization.still_open}}</span>
          {{else}}
          <span class="battle__badge battle__badge--quiet">{{@root.localization.comfortable_lead}}</span>
          {{/if}}
        </div>
        <div class="battle__side battle__side--right">
          <div class="battle__driver">
            <img src="./assets/country-flags/{{this.secondPlaceCountry}}.png" class="img-sm" alt="{{this.secondPlaceCountry}}" />
            <span class="battle__name">{{this.secondPlace}}</span>
          </div>
          <div class="battle__points">
            {{this.secondPlacePoints}}
            <span class="battle__points-unit">{{#if this.dropRoundPoints}}{{@root.localization.adr}}{{else}}{{@root.localization.pts}}{{/if}}</span>
          </div>
          <div class="battle__bar"><span class="battle__bar-fill battle__bar-fill--second" style="width: {{this.secondPlaceBarPercent}}%"></span></div>
        </div>
      </div>
      <footer class="battle__foot">
        <span>{{this.totalPointsRemaining}} {{@root.localization.points_still_available}}</span>
        <a class="home-link" href="./{{this.divisionId}}-driver-standings.html">{{@root.localization.view_standings}} →</a>
      </footer>
    </section>
    {{/with}}
    {{#with this.season}}
    <section class="home-card home-duo__season">
      <header class="home-card__head">
        <h2 class="home-card__title">
          {{@root.localization.season}}
          {{#if @root.multipleDivisions}}<span class="home-card__title-note">{{this.divisionName}}</span>{{/if}}
        </h2>
      </header>
      <dl class="stat-list">
        <div class="stat-row">
          <dt>{{@root.localization.rounds_run}}</dt>
          <dd>{{this.completedEvents}} / {{this.totalEvents}}</dd>
        </div>
        <div class="stat-row">
          <dt>{{@root.localization.drivers}}</dt>
          <dd>{{this.driverCount}}</dd>
        </div>
        <div class="stat-row">
          <dt>{{@root.localization.different_winners}}</dt>
          <dd>{{this.uniqueWinners}}</dd>
        </div>
        <div class="stat-row">
          <dt>{{@root.localization.dnfs}}</dt>
          <dd>{{this.totalDnfs}}</dd>
        </div>
        <div class="stat-row">
          <dt>{{@root.localization.avg_entries_per_event}}</dt>
          <dd>{{this.avgEntriesPerEvent}}</dd>
        </div>
      </dl>
      {{#if this.closestFinish}}
      <div class="stat-note">
        <span class="stat-note__label">{{@root.localization.closest_finish}}</span>
        <span class="stat-note__value">{{this.closestFinish.margin}}</span>
        <span class="stat-note__detail">{{this.closestFinish.winner}} {{@root.localization.vs}} {{this.closestFinish.secondPlace}} · {{this.closestFinish.event}}</span>
      </div>
      {{/if}}
    </section>
    {{/with}}
    {{/each}}
  </div>
  {{/if}}

  {{#each roundGroups}}
  <section class="home-card">
    <header class="home-card__head">
      <h2 class="home-card__title">
        {{../localization.calendar}}
        {{#if this.divisionName}}<span class="home-card__title-note">{{this.divisionName}}</span>{{/if}}
      </h2>
    </header>
    <div class="rounds-grid">
      {{#each this.rounds}}
      <a class="round-card round-card--{{this.state}}"{{#if this.href}} href="{{this.href}}"{{/if}}>
        <div class="round-card__top">
          <span class="round-card__round">R{{this.round}}</span>
          <span class="round-card__badge">{{this.statusLabel}}</span>
        </div>
        <div class="round-card__name">{{this.name}}</div>
        {{#if this.winner}}
        <div class="round-card__winner">{{../../localization.winner}} {{this.winner}}</div>
        {{else if this.startDate}}
        <div class="round-card__date">{{this.startDate}}</div>
        {{/if}}
      </a>
      {{/each}}
    </div>
  </section>
  {{/each}}

  <div class="home-grid-2 home-grid-2--paired">
    {{#if lastCompletedEvents.length}}
    <section class="home-card">
      <header class="home-card__head">
        <h2 class="home-card__title">{{localization.last_event_winners}}</h2>
      </header>
      <div class="home-card__body">
        {{#each lastCompletedEvents}}
        <div class="recap">
          <div class="recap__head">
            <span class="recap__event">{{this.name}}</span>
            {{#if ../multipleDivisions}}<span class="recap__division">{{this.divisionName}}</span>{{/if}}
          </div>
          <div class="recap__winner">
            <img src="./assets/country-flags/{{this.winnerCountry}}.png" class="img-sm" alt="{{this.winnerCountry}}" />
            <span class="recap__name">{{this.winner}}</span>
            <span class="recap__margin">{{../localization.won_by}} {{this.margin}}</span>
          </div>
          <div class="recap__foot">
            <span>{{this.totalEntries}} {{../localization.entries}}</span>
            <a class="home-link" href="./{{this.divisionId}}-{{this.eventIndex}}-driver-results.html">{{../localization.view_results}} →</a>
          </div>
        </div>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if formGuide.length}}
    <section class="home-card">
      <header class="home-card__head">
        <h2 class="home-card__title">{{localization.hot_streaks}}</h2>
      </header>
      <div class="home-card__body">
        {{#each formGuide}}
        <div class="streak">
          <div class="streak__driver">
            <img src="./assets/country-flags/{{this.country}}.png" class="img-sm" alt="{{this.country}}" />
            <span class="streak__name">{{this.name}}</span>
            {{#if ../multipleDivisions}}<span class="streak__division">{{this.divisionName}}</span>{{/if}}
          </div>
          <div class="streak__stats">
            {{this.wins}} {{#if (eq this.wins 1)}}{{../localization.win}}{{else}}{{../localization.wins}}{{/if}} · {{this.podiums}} {{#if (eq this.podiums 1)}}{{../localization.podium}}{{else}}{{../localization.podiums}}{{/if}} {{../localization.in_last_3_events}}
          </div>
          <div class="streak__recent">
            {{../localization.recent_finishes}}
            {{#each this.recentFinishes}}<span class="streak__finish">{{this}}</span>{{/each}}
          </div>
        </div>
        {{/each}}
      </div>
    </section>
    {{/if}}
  </div>

  <div class="home-grid-2 home-grid-2--paired">
    {{#each top3ByDivision}}
    <section class="home-card home-card--table">
      <header class="home-card__head">
        <h2 class="home-card__title">
          {{../localization.top_3_drivers}}
          {{#if ../multipleDivisions}}<span class="home-card__title-note">{{this.divisionName}}</span>{{/if}}
        </h2>
      </header>
      <table class="top-drivers-table">
        <tbody>
          {{#each this.top3}}
          <tr{{#if this.zone}} class="{{this.zone}}"{{/if}}>
            <td class="td-pos">{{this.standing.currentPosition}}</td>
            <td class="td-change">
              {{#if this.positive}}
              <span class="positive"><i class="arrow up"></i>&nbsp;{{this.standing.positionChange}}</span>
              {{/if}}
              {{#if this.neutral}}
              <span class="neutral">=</span>
              {{/if}}
              {{#if this.negative}}
              <span class="negative"><i class="arrow down"></i>&nbsp;{{this.standing.positionChange}}</span>
              {{/if}}
            </td>
            <td class="td-nat">
              <img src="./assets/country-flags/{{this.country.code}}.png" class="img-sm"
                alt="{{this.country.code}}" title="{{this.country.code}}" />
            </td>
            <td class="td-driver text-left bold">{{this.driver.name}}</td>
            <td class="td-points bold">
              {{this.points}}{{#if this.dropRoundPoints}} {{../../localization.adr}}<span class="points-total">{{this.standing.totalPoints}} {{../../localization.pts}}</span>{{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </section>
    {{/each}}
    {{#if showCarPerformance}}
    {{#if carStats}}
    <section class="home-card">
      <header class="home-card__head">
        <h2 class="home-card__title">{{localization.car_performance}}</h2>
      </header>
      <div class="home-card__body">
        {{#if carStats.mostWins}}
        <div class="car-stat">
          <div class="car-stat__label">{{localization.most_wins}}</div>
          <div class="car-stat__name">{{carStats.mostWins.name}}</div>
          <div class="car-stat__detail">
            {{carStats.mostWins.wins}} {{#if (eq carStats.mostWins.wins 1)}}{{localization.win}}{{else}}{{localization.wins}}{{/if}} · {{carStats.mostWins.podiums}} {{#if (eq carStats.mostWins.podiums 1)}}{{localization.podium}}{{else}}{{localization.podiums}}{{/if}} · {{carStats.mostWins.winRate}}% {{localization.win_rate}}
          </div>
        </div>
        {{/if}}
        {{#if carStats.bestAverage}}
        <div class="car-stat">
          <div class="car-stat__label">{{localization.best_average_performance}}</div>
          <div class="car-stat__name">{{carStats.bestAverage.name}}</div>
          <div class="car-stat__detail">
            {{carStats.bestAverage.avgPoints}} {{localization.avg_points}} · {{carStats.bestAverage.entries}} {{#if (eq carStats.bestAverage.entries 1)}}{{localization.entry}}{{else}}{{localization.entries}}{{/if}}
          </div>
        </div>
        {{/if}}
      </div>
    </section>
    {{/if}}
    {{/if}}

    {{#if rules}}
    <section class="home-card">
      <header class="home-card__head">
        <h2 class="home-card__title">{{localization.championship_rules}}</h2>
      </header>
      <div class="home-card__body">
        {{#if rules.dropRounds}}
        <p class="rule"><span class="rule__label">{{localization.drop_rounds}}</span> {{rules.dropRounds}} {{#if (eq rules.dropRounds 1)}}{{localization.drop_rounds_singular_text}}{{else}}{{localization.drop_rounds_plural_text}}{{/if}}</p>
        {{/if}}
        {{#if rules.overallPointsTop5.length}}
        <p class="rule"><span class="rule__label">{{localization.points_top_5}}</span> {{#each rules.overallPointsTop5}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
        {{/if}}
        {{#if rules.powerStagePoints.length}}
        <p class="rule"><span class="rule__label">{{localization.power_stage_points}}</span> {{#each rules.powerStagePoints}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
        {{/if}}
        {{#each divisionInfo}}
        <div class="rule-division">
          <div class="rule-division__name">{{this.name}}</div>
          {{#if this.cars}}
          <div class="rule__label">{{../localization.allowed_cars}}</div>
          <ul class="rule-cars">
            {{#each this.cars}}<li>{{this}}</li>{{/each}}
          </ul>
          {{/if}}
          {{#if this.excludedCars}}
          <div class="rule__label">{{../localization.banned_cars}}</div>
          <ul class="rule-cars">
            {{#each this.excludedCars}}<li>{{this}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
        {{/each}}
      </div>
    </section>
    {{/if}}
  </div>
</div>
