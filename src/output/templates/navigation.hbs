<header class="siteHeader">
  <div class="siteHeader__bar">
    <div class="navLeft navDesktopOnly">
      <div class="dropdown">
        <a class="brand" href="./index.html" aria-label="Home">
          <img class="brand__img" src="./assets/{{logo}}" alt="Logo" />
          <span class="brand__name">{{siteTitlePrefix}}</span>
        </a>

        <div class="dropdown__menu" role="menu">
          {{#if links.series}}
            <div class="dropdown__title">— {{localization.series}} —</div>
            {{#each links.series}}
              <a class="dropdown__item" href="{{href}}">{{name}}</a>
            {{/each}}
          {{/if}}

          {{#if links.historical}}
            <div class="dropdown__title">— {{localization.historical}} —</div>
            {{#each links.historical}}
              <a class="dropdown__item" href="{{href}}">{{name}}</a>
            {{/each}}
          {{/if}}
        </div>
      </div>
    </div>

<nav class="navMain navDesktopOnly" aria-label="Primary">
  <a class="navBtn navBtn--link{{#if homeActive}} isActive{{/if}}" href="./index.html">
    {{localization.home}}
  </a>
  {{#if primaryResultsHref}}
    <div{{#if hasMultipleResults}} class="navDrop" tabindex="0"{{/if}}>
      <a class="navBtn navBtn--link{{#if resultsActive}} isActive{{/if}}" href="{{primaryResultsHref}}">
        {{localization.driver_results}}
      </a>
      <div class="navMenu">
        {{#each resultsLinks}}
          <a class="navLink{{#if ../resultsActive}}{{#if active}} isActive{{/if}}{{/if}}" href="{{href}}">{{link}}</a>
        {{/each}}
      </div>
    </div>
  {{/if}}
  {{#if links.driver}}
    <div{{#if hasMultipleDriverStandings}} class="navDrop" tabindex="0"{{/if}}>
      <a class="navBtn navBtn--link{{#if driverStandingsActive}} isActive{{/if}}" href="{{primaryDriverHref}}">
        {{localization.driver_standings}}
      </a>

      <div class="navMenu">
        {{#with links.driver}}
          {{#each this}}
            <a class="navLink{{#if ../../driverStandingsActive}}{{#if active}} isActive{{/if}}{{/if}}" href="{{href}}">
              {{link}}
            </a>
          {{/each}}
        {{/with}}
      </div>
    </div>
  {{/if}}

  {{#if links.team}}
    <div{{#if hasMultipleTeamStandings}} class="navDrop" tabindex="0"{{/if}}>
      <a class="navBtn navBtn--link{{#if teamStandingsActive}} isActive{{/if}}" href="{{primaryTeamHref}}">
        {{localization.team_standings}}
      </a>

      <div class="navMenu">
        {{#with links.team}}
          {{#each this}}
            <a class="navLink{{#if ../../teamStandingsActive}}{{#if active}} isActive{{/if}}{{/if}}" href="{{href}}">
              {{link}}
            </a>
          {{/each}}
        {{/with}}
      </div>
    </div>
  {{/if}}

  {{#if links.fantasy}}
    <div class="navDrop" tabindex="0">
      <button class="navBtn" type="button" aria-haspopup="true">
        Fantasy JRC
      </button>

      <div class="navMenu">
        {{#with links.fantasy}}
          {{#each this}}
            <a class="navLink {{#if active}}isActive{{/if}}" href="{{href}}">
              {{link}}
            </a>
          {{/each}}
        {{/with}}
      </div>
    </div>
  {{/if}}
</nav>


    {{#if endTime}}
      <div class="navRight navDesktopOnly">
        <span class="countdown__dot" aria-hidden="true"></span>
        <span id="countdown2" class="countdown"></span>
      </div>
    {{/if}}

    <button
      type="button"
      class="iconBtn navMobileOnly"
      aria-controls="seriesMobileNav"
      aria-label="Choose series"
      onclick="toggleControlledNav(this)"
    >
      <img class="brand__img brand__img--mobile" src="./assets/{{logo}}" alt="Logo" />
    </button>

    <div class="navTitle navMobileOnly">
      <div class="navTitle__main">{{siteTitlePrefix}}</div>
    </div>

		<button
      type="button"
      class="iconBtn navMobileOnly"
      aria-controls="mobileNav"
      aria-label="Open menu"
      onclick="toggleControlledNav(this)"
    >
      <span class="hamburger" aria-hidden="true">☰</span>
    </button>
  </div>

  <div id="mobileNav" class="drawer" hidden>
    <nav class="drawer__content" aria-label="Mobile menu">
      <a class="drawer__link{{#if homeActive}} isActive{{/if}}" href="./index.html">
        {{localization.home}}
      </a>
      {{#each resultsLinks}}
        <a class="drawer__link{{#if ../resultsActive}}{{#if active}} isActive{{/if}}{{/if}}" href="{{href}}">
          {{../localization.driver_results}} - {{link}}
        </a>
      {{/each}}
      {{#with links.driver}}
        {{#each this}}
          <a class="drawer__link{{#if ../../driverStandingsActive}}{{#if active}} isActive{{/if}}{{/if}}" href="{{href}}">
            {{../../localization.driver_standings}} - {{link}}
          </a>
        {{/each}}
      {{/with}}

      {{#with links.team}}
        {{#each this}}
          <a class="drawer__link{{#if ../../teamStandingsActive}}{{#if active}} isActive{{/if}}{{/if}}" href="{{href}}">
            {{../../localization.team_standings}} - {{link}}
          </a>
        {{/each}}
      {{/with}}

      {{#with links.overall}}
        {{#each this}}
          <a class="drawer__link {{#if active}}isActive{{/if}}" href="{{href}}">
            {{../../localization.overall}} - {{link}}
          </a>
        {{/each}}
      {{/with}}
    </nav>
  </div>

  <div id="seriesMobileNav" class="drawer" hidden>
    <div class="drawer__content">
      {{#if links.series}}
        <div class="drawer__title">— {{localization.series}} —</div>
        {{#each links.series}}
          <a class="drawer__link" href="{{href}}">{{name}}</a>
        {{/each}}
      {{/if}}

      {{#if links.historical}}
        <div class="drawer__title">— {{localization.historical}} —</div>
        {{#each links.historical}}
          <a class="drawer__link" href="{{href}}">{{name}}</a>
        {{/each}}
      {{/if}}
    </div>
  </div>

</header>

{{#if endTime}}
<script>
  var countDownDate = new Date("{{endTime}}").getTime();
  var updateCountdown = function() {
    var now = new Date().getTime();
    var distance = countDownDate - now;

    var days = Math.floor(distance / (1000 * 60 * 60 * 24));
    var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    var seconds = Math.floor((distance % (1000 * 60)) / 1000);

    var text = days + "d " + hours + "h " + minutes + "m " + seconds + "s ";

    var c1 = document.getElementById("countdown");
    var c2 = document.getElementById("countdown2");

    // The homepage hero splits the same countdown into labelled units.
    var clockUnits = {
      homeClockDays: days,
      homeClockHours: hours,
      homeClockMinutes: minutes,
      homeClockSeconds: seconds
    };
    var setClock = function(ended) {
      Object.keys(clockUnits).forEach(function(id) {
        var el = document.getElementById(id);
        if (!el) return;
        var value = ended ? 0 : clockUnits[id];
        el.innerHTML = id === "homeClockDays" ? value : ("0" + value).slice(-2);
      });
      var label = document.getElementById("homeClockLabel");
      if (label && ended) label.innerHTML = "{{localization.event_ended}}";
    };

    if (distance < 0) {
      clearInterval(x);
      if (c1) c1.innerHTML = "Event Ended";
      if (c2) c2.innerHTML = "Event Ended";
      setClock(true);
      return false;
    }
    if (c1) c1.innerHTML = text;
    if (c2) c2.innerHTML = text;
    setClock(false);
    return true;
  };
  var x;
  if (updateCountdown()) x = setInterval(updateCountdown, 1000);
  // This runs in the head, before the homepage hero exists, so the split
  // clock is filled again as soon as the body has parsed rather than
  // showing placeholders until the first tick.
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", function() {
      updateCountdown();
    });
  }
</script>
{{/if}}
