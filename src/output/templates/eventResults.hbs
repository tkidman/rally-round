<div class="container">
  <div class="flexContainer">
    <div class="flexBox">
      <div class="page-heading">
        <div class="page-heading__titles">
          <div class="page-heading__eyebrow">
            {{siteTitlePrefix}}{{#if pageContext}} · {{pageContext}}{{/if}} · R{{roundNumber}} {{localization.of}} {{totalRounds}}
          </div>
          <h1 class="page-heading__title">{{resultsTitle}}</h1>
        </div>
        <div class="page-heading__navigation" aria-label="Event navigation">
          {{#if previousEventHref}}
          <a class="page-heading__nav-button" href="{{previousEventHref}}">← {{localization.previous}}</a>
          {{/if}}
          {{#if nextEventHref}}
          <a class="page-heading__nav-button" href="{{nextEventHref}}">{{localization.next}} →</a>
          {{/if}}
        </div>
      </div>
      {{{eventNav}}}
      {{#if podium.length}}
      <div class="podium">
        {{#each podium}}
        <div class="podium__item podium__item--{{this.position}}">
          <div class="podium__top">
            <span class="podium__pos">{{this.position}}</span>
            <span class="podium__points">{{this.pointsDisplay}} {{../localization.pts}}</span>
          </div>
          <div class="podium__name">
            <img src="./assets/country-flags/{{this.country.code}}.png" class="img-sm" alt="{{this.country.code}}" />
            <span>{{this.driver.name}}</span>
          </div>
          {{#if ../showCarName}}
          <div class="podium__car">
            {{#if this.car}}
            <img class="podium__car-logo" src="./assets/cars/{{this.car}}.png" alt="{{this.car}}"
              title="{{this.car}}" />
            {{/if}}
            <span>{{this.entry.vehicleName}}</span>
          </div>
          {{/if}}
          <div class="podium__times">
            <span class="podium__total">{{this.totalTimeDisplay}}</span>
            <span class="podium__gap">{{#if @first}}{{../localization.leader}}{{else}}{{this.totalDiffDisplay}}{{/if}}</span>
          </div>
        </div>
        {{/each}}
      </div>
      {{/if}}
      <div class="column-chips" role="group" aria-label="Filter columns">
        <span class="column-chips__label" aria-hidden="true">Filter Columns</span>
        <div class="column-chips__items"></div>
      </div>
      <div class="table-scroll-indicator" id="tableScrollIndicator" aria-hidden="true">
        <div class="table-scroll-indicator__content"></div>
      </div>
      <div class="table-scroll-wrapper">
        <table id="tableDrivers" class="event-results-table">
          <thead>
            <tr>
              <th class="th-pos">{{localization.pos}}</th>
              <th class="th-nat">{{localization.nat}}</th>
              <th class="th-driver">{{localization.driver}}</th>
              {{#if overall}}
              <th class="th-div">{{localization.div}}</th>
              {{/if}}
              {{#if showTeam}}
              {{#unless hideTeamLogoColumn}}
              <th class="th-team-logo">{{localization.team}}</th>
              {{/unless}}
              {{#if showTeamNameTextColumn}}
              <th class="th-team-name">{{localization.team_name}}</th>
              {{/if}}
              {{/if}}
              {{#if showTeam2LogoColumn}}
              <th class="th-team2">{{team2ColumnName}}</th>
              {{/if}}
              {{#if showPowerStage}}
              <th class="th-ps">{{localization.ps}}</th>
              <th class="th-diff">{{localization.diff}}</th>
              {{/if}}
              <th class="th-total">{{localization.total}}</th>
              <th class="th-diff">{{localization.diff}}</th>
              {{#if showSuperRallyColumn}}
              <th class="th-sr">{{localization.sr}}</th>
              {{/if}}
              {{#if showLegPoints}}
              {{#each event.legs}}
              <th class="th-leg">
                <a href="{{this.legUrl}}">{{this.legColumnHeader}}</a>
              </th>
              {{/each}}
              {{/if}}
              {{#if showStagePoints}}
              <th class="th-stage-points th-abbr" data-short="{{localization.stage_points_short}}"><span class="th-abbr__full">{{localization.stage_points}}</span></th>
              {{/if}}
              {{#if showPowerStagePoints}}
              <th class="th-ps-points th-abbr" data-short="{{localization.ps}} {{localization.points_short}}"><span class="th-abbr__full">{{localization.ps}} {{localization.points}}</span></th>
              {{/if}}
              <th class="th-points th-abbr" data-short="{{localization.points_short}}"><span class="th-abbr__full">{{localization.points}}</span></th>
              <th class="th-total-points th-abbr" data-short="{{localization.total_points_short}}"><span class="th-abbr__full">{{localization.total_points}}</span></th>
            </tr>
          </thead>
          <tbody>
            {{#each rows}}
            <tr>
              <td class="td-pos">{{this.position}}</td>
              <td class="td-nat">
                <img src="./assets/country-flags/{{this.country.code}}.png" class="img-sm"
                  alt="{{this.country.code}}" title="{{this.country.code}}" />
              </td>
              <td class="td-driver text-left bold">
                <span class="td-driver__name">{{this.driver.name}}</span>
                {{#if ../showCar}}
                {{#if this.car}}
                <span class="td-driver__car">
                  <img class="td-driver__car-logo" src="./assets/cars/{{this.car}}.png" alt="{{this.car}}"
                    title="{{this.car}}" />
                  {{#if ../showCarName}}<span class="td-driver__car-name">{{this.entry.vehicleName}}</span>{{/if}}
                </span>
                {{/if}}
                {{/if}}
              </td>
              {{#if ../overall}}
              <td class="td-div">{{this.divisionDisplayName}}</td>
              {{/if}}
              {{#if ../showTeam}}
              {{#unless ../hideTeamLogoColumn}}
              <td class="td-team-logo">
                <img src="{{teamLogo}}" class="img-md" alt="{{this.teamId}}"
                  title="{{this.teamId}}" />
              </td>
              {{/unless}}
              {{#if ../showTeamNameTextColumn}}
              <td class="td-team-name text-left">{{this.teamId}}</td>
              {{/if}}
              {{/if}}
              {{#if ../showTeam2LogoColumn}}
              <td class="td-team2">
                <img src="{{this.team2Logo}}" class="img-md" alt="{{this.driver.team2Id}}"
                  title="{{this.driver.team2Id}}" />
              </td>
              {{/if}}
              {{#if ../showPowerStage}}
              <td class="td-ps">{{this.stageTimeDisplay}}</td>
              <td class="td-diff">{{this.stageDiffDisplay}}</td>
              {{/if}}
              {{#if this.entry.extraInfo}}
              <td class="td-total popup" onclick="openPopup('{{this.entry.name}}')">
                {{this.totalTimeDisplay}}
                <span class="popuptext" id="{{this.entry.name}}">{{this.entry.extraInfo}}</span>
              </td>
              {{else}}
              <td class="td-total">{{this.totalTimeDisplay}}</td>
              {{/if}}
              <td class="td-diff">{{this.totalDiffDisplay}}</td>
              {{#if ../showSuperRallyColumn}}
              <td class="td-sr">
                {{this.entry.superRally}}
              </td>
              {{/if}}
              {{#if ../showLegPoints}}
              {{#each this.legPoints}}
              <td class="td-leg">{{this}}</td>
              {{/each}}
              {{/if}}
              {{#if ../showStagePoints}}
              <td class="td-stage-points">{{this.stagePoints}}</td>
              {{/if}}
              {{#if ../showPowerStagePoints}}
              <td class="td-ps-points">{{this.powerStagePoints}}</td>
              {{/if}}
              <td class="td-points">{{this.overallPoints}}</td>
              <td class="td-total-points bold">{{this.pointsDisplay}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      <div class="text-center">
        <p>{{localization.last_updated}}: {{lastUpdatedAt}}</p>
      </div>
      {{#if event.enduranceRoundMultiplier}}
      <div class="text-center">
        <p>{{localization.endurance_multiplied}} {{event.enduranceRoundMultiplier}}</p>
      </div>
      {{/if}}
      {{#if fullResultsLink}}
      <div class="text-center">
        <a href="{{fullResultsLink}}" target="_none">{{localization.full_results}}</a>
      </div>
      {{/if}}
    </div>
  </div>
</div>
